{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "my-weblogggggg",
  "main": "src/worker.js",
  "compatibility_date": "2025-01-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "blog-db",
      "database_id": "PUT-YOUR-DATABASE-ID-HERE"
    }
  ]
}
